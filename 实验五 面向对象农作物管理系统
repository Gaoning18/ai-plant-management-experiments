# 创建作物类
class Crop(object):
    # 初始化构造函数，实例属性
    def __init__(self, plant_name="", status="", disease="", advice="", plant_date="", note=""):
        self._plant_id = None
        self.plant_name = plant_name
        self.status = status
        self.disease = disease
        self.advice = advice
        self.plant_date = plant_date
        self.note = note

    # 只读属性，外面只能看不能赋值
    @property
    def plant_id(self):
        return self._plant_id

    # 打印植物详细信息
    def display(self):
        print(f"plant_id:{self.plant_id},品种:{self.plant_name},状态:{self.status},疾病:{self.disease},建议:{self.advice},日期:{self.plant_date},备注:{self.note}")

    # 将对象转换成字典
    def to_dict(self):
        return {
            "plant_id": self.plant_id,
            "plant_name": self.plant_name,
            "status": self.status,
            "disease": self.disease,
            "advice": self.advice,
            "plant_date": self.plant_date,
            "note": self.note
        }

    # 返回是否健康
    def is_healthy(self):
        return self.status == "healthy"

    # 从字典创建Crop对象
    @classmethod
    def from_dict(cls, data):
        obj = cls(
            plant_name=data["plant_name"],
            status=data["status"],
            disease=data["disease"],
            advice=data["advice"],
            plant_date=data["plant_date"],
            note=data["note"]
        )
        obj._plant_id = data["plant_id"]
        return obj


# 设计CropDatabase类（管理所有植物）
class CropDatabase(object):
    def __init__(self):
        self.plants = []  # 初始化新列表
        self._next_id = 1  # 下一个可以用的编号

    # 添加一棵植物
    def add_plant(self, plant_name="", status="", disease="", advice="", plant_date="", note=""):
        crop = Crop(plant_name, status, disease, advice, plant_date, note)
        # 给作物绑定id
        crop._plant_id = self._next_id
        self.plants.append(crop)
        self._next_id += 1
        return crop.plant_id

    # 根据编号删除植物
    def remove(self, plant_id):
        for crop in self.plants:
            if crop.plant_id == plant_id:
                self.plants.remove(crop)
                return True  # 删除成功
        return False  # 删除失败

    # 根据编号修改植物信息 **kwargs 可以一次性传任意多个要修改的字段
    def update(self, _plant_id, **kwargs):
        crop = self.find_by_id(_plant_id)
        if crop is None:
            return False
        if "plant_name" in kwargs:
            crop.plant_name = kwargs["plant_name"]
        if "status" in kwargs:
            crop.status = kwargs["status"]
        if "disease" in kwargs:
            crop.disease = kwargs["disease"]
        if "advice" in kwargs:
            crop.advice = kwargs["advice"]
        if "plant_date" in kwargs:
            crop.plant_date = kwargs["plant_date"]
        if "note" in kwargs:
            crop.note = kwargs["note"]
        return True

    # 根据编号查找植物，返回Crop对象或None
    def find_by_id(self, plant_id):
        for c in self.plants:
            if c.plant_id == plant_id:
                return c
        return None

    # 根据品种名查找该品种所有植物
    def find_by_name(self, plant_name):
        res_list = []
        for c in self.plants:
            if c.plant_name == plant_name:
                res_list.append(c)
        return res_list

    # 返回所有植物列表
    def list_all(self):
        return self.plants

    # 按品种分组统计（返回各品种的总数、健康数、病变数）
    def get_summary(self):
        summary = {}
        for crop in self.plants:
            if crop.plant_name not in summary:
                summary[crop.plant_name] = {"total": 0, "healthy": 0, "sick": 0}
            summary[crop.plant_name]["total"] += 1
            if crop.is_healthy():
                summary[crop.plant_name]["healthy"] += 1
            else:
                summary[crop.plant_name]["sick"] += 1
        return summary

    # 统计植物总数
    def total_count(self):
        return len(self.plants)


