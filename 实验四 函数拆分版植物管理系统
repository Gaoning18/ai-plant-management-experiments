def display_summary(plant_list: list):
    """按品种分组显示汇总信息（总数、健康数、病变数）"""
    if len(plant_list) == 0:
        print("⚠️ 暂无植物数据！")
        return
    group_dict = {}
    for plant in plant_list:
        n = plant["name"]
        if n not in group_dict:
            group_dict[n] = {"total": 0, "healthy": 0, "ill": 0}
        group_dict[n]["total"] += 1
        if plant["status"] == "健康":
            group_dict[n]["healthy"] += 1
        else:
            group_dict[n]["ill"] += 1
    print("===品种汇总===")
    for k, v in group_dict.items():
        print(f"品种：{k:6s} | 总数：{v['total']} | 健康：{v['healthy']} | 病变：{v['ill']}")


def display_by_name(plant_list: list, search_name: str):
    """显示指定品种下所有植物明细"""
    res = [x for x in plant_list if x["name"] == search_name]
    if not res:
        print("⚠️ 没有找到该品种！")
    else:
        print(f"==== {search_name} 明细 ====")
        for plant in res:
            show_plant(plant)


def add_plant(plant_list: list):
    """添加植物信息"""
    name = input("请输入植物名称:")

    while True:
        status = input("请输入植物的健康状态(健康/病变)：")
        if status in ("健康", "病变"):
            break
        print("[错误] 请输入正确的植物健康状态！")

    disease = ""
    if status == "健康":
        advice = input("请输入养护建议：")
    else:
        disease = input("请输入病变名称:")
        advice = input("请输入治疗/养护建议：")

    plant_date = input("请输入种植/录入日期(格式：2026-08-01)：")

    # 修复：备注赋值bug
    while True:
        note_opt = input("是否需要备注(是/否)：")
        if note_opt == "是":
            note = input("请输入你的备注：")
            break
        elif note_opt == "否":
            note = "无"
            break
        print("[错误] 只能输入 是 或 否！")

    plant_id = get_next_id(plant_list)
    new_plant = {
        "plant_id": plant_id,
        "name": name,
        "status": status,
        "disease": disease,
        "advice": advice,
        "plant_date": plant_date,
        "note": note
    }
    plant_list.append(new_plant)
    print("✅ 添加成功！")


def update_plant(plant_list: list):
    """根据编号修改一棵植物信息"""
    try:
        edit_pid = int(input("请输入需要修改的plant_id:"))
    except ValueError:
        print("[错误] 编号必须为数字！")
        return

    target = None
    for plant in plant_list:
        if plant["plant_id"] == edit_pid:
            target = plant
            break
    if target is None:
        print("⚠️ 找不到这个编号！")
        return

    print("\n原信息：")
    show_plant(target)
    print("=== 请重新录入信息 ===")

    target["name"] = input("植物名称：")
    while True:
        s = input("状态（健康/病变）：")
        if s in ("健康", "病变"):
            target["status"] = s
            break
        print("[错误] 只能输入 健康 或 病变")

    if target["status"] == "健康":
        target["disease"] = ""
        target["advice"] = input("养护建议：")
    else:
        target["disease"] = input("请输入病变疾病：")
        target["advice"] = input("治疗/养护建议：")

    target["plant_date"] = input("种植日期：")
    while True:
        note_opt = input("是否需要输入备注(是/否)：")
        if note_opt == "是":
            target["note"] = input("请输入备注：")
            break
        elif note_opt == "否":
            target["note"] = "无"
            break
        print("[错误] 只能输入 是 或 否！")
    print("✅ 修改成功！")


def delete_plant(plant_list: list):
    """根据编号删除植物"""
    while True:
        try:
            del_id = int(input("请输入需要删除的plant_id:"))
            break
        except ValueError:
            print("[错误] 编号必须为数字，请重新输入")

    find_idx = None
    for i, p in enumerate(plant_list):
        if p["plant_id"] == del_id:
            find_idx = i
            break

    if find_idx is None:
        print("⚠️ 找不到该编号！")
        return
    print("\n待删除信息：")
    show_plant(plant_list[find_idx])
    ans = input("是否确认删除？(是/否):")
    if ans == "是":
        plant_list.pop(find_idx)
        print("✅ 删除成功！")
    else:
        print("已取消删除")


def find_plant(plants: list, plant_id: int):
    """根据编号查找植物，返回植物字典或None"""
    for p in plants:
        if p["plant_id"] == plant_id:
            return p
    return None


def get_next_id(plants: list) -> int:
    """计算并返回下一个可用的plant_id"""
    if not plants:
        return 1
    id_list = [p["plant_id"] for p in plants]
    max_id = max(id_list)
    return max_id + 1


