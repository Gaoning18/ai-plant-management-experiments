Description:
    函数拆分版植物管理系统，所有功能独立封装为函数
    函数清单：
    load_sample_data()    - 加载预置示例数据
    show_plant()          - 格式化打印单株植物
    display_summary()     - 品种汇总统计
    display_by_name()     - 按品种名称查询明细
    add_plant()           - 添加植物
    update_plant()        - 根据plant_id修改植物
    delete_plant()        - 根据plant_id删除植物
    find_plant()          - 根据plant_id查找，返回dict/None
    get_next_id()         - 获取下一个可用plant_id
"""


def show_plant(plant: dict):
    """格式化打印单株植物信息"""
    print("-" * 50)
    print(f"plant_id: {plant['plant_id']}")
    print(f"名称: {plant['name']}")
    print(f"状态: {plant['status']}")
    print(f"病害: {plant['disease'] if plant['disease'] else '无'}")
    print(f"养护建议: {plant['advice']}")
    print(f"种植日期: {plant['plant_date']}")
    print(f"备注: {plant['note']}")
    print("-" * 50)


